# Database
DATABASE_URL="postgresql://ims:ims_dev_password@127.0.0.1:5433/dxvalley_ims?schema=public"

# API
HOST=127.0.0.1
PORT=4000
NODE_ENV=development
JWT_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
ACCESS_TOKEN_TTL="8h"
REFRESH_TOKEN_TTL="7d"
WEB_ORIGIN="http://localhost:3000"
# Leave unset to follow NODE_ENV (production => Secure). Set explicitly when a
# production build is served over plain HTTP, otherwise the browser drops the session.
COOKIE_SECURE=false
# Path prefix when nginx serves the app at http://host/ims. Keep it in sync with
# NEXT_PUBLIC_BASE_PATH. Unset = app served from the root.
COOKIE_BASE_PATH=""

# Web
API_URL="http://127.0.0.1:4000"
NEXT_PUBLIC_APP_NAME="DxValley IMS"
# Build-time only: changing it requires `npm run build -w @ims/web`.
NEXT_PUBLIC_BASE_PATH=""
